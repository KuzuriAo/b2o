{
  "name": "@kuzuri.ao/b2o",
  "private": false,
  "version": "0.0.9",
  "type": "module",
  "description": "Convert Bambu Studio, Creality Print, and Anycubic Slicer Next .3mf files to Snapmaker U1 / OrcaSlicer format from the command line.",
  "license": "MIT",
  "keywords": [
    "bambu-lab",
    "bambu-studio",
    "creality",
    "anycubic",
    "snapmaker",
    "snapmaker-u1",
    "orcaslicer",
    "3mf",
    "3d-printing",
    "slicer",
    "cli"
  ],
  "author": "Kuzuri",
  "homepage": "https://b2o.kuzuriao.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KuzuriAo/b2o.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/b2o"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "b2o": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.mjs && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "undici": "^6.28.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^3.25.0"
  }
}
